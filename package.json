{
  "name": "qyplayer",
  "private": true,
  "version": "0.0.0",
  "description": "qyPlayer: open-source, local-first memory film player and .qyp package format",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures:fetch": "tsx scripts/fetch-fixtures.ts",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "fixtures:docs": "tsx scripts/check-fixtures.ts --write",
    "fixtures:conformance": "tsx scripts/build-conformance.ts",
    "schema:build": "tsx scripts/build-validator.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qyplayer/core": "workspace:*",
    "@qyplayer/qyp": "workspace:*",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "image-size": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
