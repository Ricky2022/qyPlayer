    "expect": {
      "ok": false,
      "code": "not-a-zip"
    }
  },
  {
    "file": "invalid-missing-manifest.qyp",
    "description": "根目录没有 manifest.json",
    "expect": {
      "ok": false,
      "code": "missing-manifest"
    }
  },
  {
    "file": "invalid-json.qyp",
    "description": "manifest.json 不是合法 JSON",
    "expect": {
      "ok": false,
      "code": "invalid-json"
    }
  },
  {
    "file": "invalid-manifest-schema.qyp",
    "description": "清单缺少必需字段 pages",
    "expect": {
      "ok": false,
      "code": "invalid-manifest"
    }
  },
  {
    "file": "invalid-manifest-timeline.qyp",
    "description": "页的时间不连续",
    "expect": {
      "ok": false,
      "code": "invalid-manifest"
    }
  },
  {
    "file": "invalid-version-too-high.qyp",
    "description": "格式版本高于播放器支持的版本",
    "expect": {
      "ok": false,
      "code": "unsupported-version"
    }
  },
  {
    "file": "invalid-missing-file.qyp",
    "description": "清单引用的 media/m003.jpg 不在包内",
    "expect": {
      "ok": false,
      "code": "missing-file"
    }
  },
  {
    "file": "invalid-path-escape-manifest.qyp",
    "description": "清单中的素材路径含 ../",
