{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qyplayer.invalid/spec/manifest-0.1.schema.json",
  "title": "qyPlayer package manifest, format version 0.1",
  "description": "Structural rules of manifest.json inside a .qyp package. Cross-field rules (time continuity, references, path safety) are checked by the validator in @qyplayer/core. Unknown fields are allowed and must be ignored by players (PRD 7.6). Unknown values of transitionIn.type and enter.type are allowed here and degraded by players.",
  "type": "object",
  "required": ["formatVersion", "id", "title", "createdAt", "canvas", "duration", "assets", "pages"],
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "templateId": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["aspectRatio", "width", "height", "background"],
      "properties": {
        "aspectRatio": { "enum": ["16:9", "9:16"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "cover": { "type": "string", "minLength": 1 },
    "assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } },
    "bgm": {
      "type": "object",
      "required": ["assetId"],
      "properties": {
        "assetId": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 }
      }
    },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/page" } }
  },
  "definitions": {
    "asset": {
      "type": "object",
      "required": ["id", "type", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["image", "video", "audio"] },
        "src": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "hasAudio": { "type": "boolean" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "original": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "license": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": { "required": ["width", "height"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["width", "height", "duration", "hasAudio"] }
        },
        {
          "if": { "properties": { "type": { "const": "audio" } }, "required": ["type"] },
          "then": { "required": ["duration"] }
        }
      ]
    },
    "page": {
      "type": "object",
      "required": ["id", "start", "duration", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "transitionIn": { "$ref": "#/definitions/transitionIn" },
        "items": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/item" } }
      }
    },
    "transitionIn": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "required": ["assetId", "frame"],
      "properties": {
        "assetId": { "type": "string" },
        "frame": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "fit": { "enum": ["cover", "contain"] },
        "clipStart": { "type": "number", "minimum": 0 },
        "enter": { "$ref": "#/definitions/enter" }
      }
    },
    "enter": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "delay": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 }
      }
    }
  }
}
