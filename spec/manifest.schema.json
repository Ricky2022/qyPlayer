{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qyplayer.invalid/spec/manifest-0.3.schema.json",
  "title": "qyPlayer package manifest, format versions 0.1, 0.2 and 0.3",
  "description": "Structural rules of manifest.json inside a .qyp package. Cross-field rules (time continuity, references, path safety) are checked by the validator in @qyplayer/core. Unknown fields are allowed and must be ignored by players (PRD 7.6). Unknown values of transitionIn.type and enter.type are allowed here and degraded by players. Since 0.2 every asset must carry mimeType and source; 0.1 manifests do not have them. 0.3 only adds optional fields (canvas.backdrop, items[].motion, look, subtitle, titleCard, generator.transition) and the transition type rotate.",
  "type": "object",
  "required": ["formatVersion", "id", "title", "createdAt", "canvas", "duration", "assets", "pages"],
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "templateId": { "type": "string" },
        "seed": { "type": "integer" },
        "transition": { "type": "string" },
        "plan": { "description": "Private. The page plan the creator saved after single-page edits (used to continue editing); players ignore it." }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["aspectRatio", "width", "height", "background"],
      "properties": {
        "aspectRatio": { "enum": ["16:9", "9:16"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backdrop": { "type": "string" }
      }
    },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "cover": { "type": "string", "minLength": 1 },
    "assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } },
    "bgm": {
      "type": "object",
      "required": ["assetId"],
      "properties": {
        "assetId": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 }
      }
    },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/page" } },
    "look": { "type": "string" },
    "subtitle": { "type": "string" },
    "titleCard": {
      "type": "object",
      "required": ["assetId", "start", "duration", "fadeIn", "fadeOut"],
      "properties": {
        "assetId": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 }
      }
    }
  },
  "if": { "properties": { "formatVersion": { "enum": ["0.2", "0.3"] } }, "required": ["formatVersion"] },
  "then": { "properties": { "assets": { "type": "array", "items": { "type": "object", "required": ["mimeType", "source"] } } } },
  "definitions": {
    "mimeType": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(image|video|audio)/[a-z0-9.+-]+(; ?codecs=\"[a-z0-9.,+ -]+\")?$"
    },
    "asset": {
      "type": "object",
      "required": ["id", "type", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["image", "video", "audio"] },
        "src": { "type": "string", "minLength": 1 },
        "mimeType": { "$ref": "#/definitions/mimeType" },
        "source": {
          "type": "object",
          "required": ["mimeType", "transcoded"],
          "properties": {
            "mimeType": { "$ref": "#/definitions/mimeType" },
            "transcoded": { "type": "boolean" }
          }
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "hasAudio": { "type": "boolean" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "original": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "license": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": { "required": ["width", "height"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["width", "height", "duration", "hasAudio"] }
        },
        {
          "if": { "properties": { "type": { "const": "audio" } }, "required": ["type"] },
          "then": { "required": ["duration"] }
        }
      ]
    },
    "page": {
      "type": "object",
      "required": ["id", "start", "duration", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "transitionIn": { "$ref": "#/definitions/transitionIn" },
        "items": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/item" } }
      }
    },
    "transitionIn": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "required": ["assetId", "frame"],
      "properties": {
        "assetId": { "type": "string" },
        "frame": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "fit": { "enum": ["cover", "contain"] },
        "clipStart": { "type": "number", "minimum": 0 },
        "enter": { "$ref": "#/definitions/enter" },
        "motion": { "$ref": "#/definitions/motion" }
      }
    },
    "motionState": {
      "type": "object",
      "required": ["scale", "x", "y"],
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/motionState" },
        "to": { "$ref": "#/definitions/motionState" }
      }
    },
    "enter": {
      "type": "object",
      "required": ["type", "duration"],
      "properties": {
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "delay": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 }
      }
    }
  }
}
