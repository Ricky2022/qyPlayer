{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qyPlayer",
  "version": "0.1.0",
  "identifier": "io.github.ricky2022.qyplayer",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "qyPlayer",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "qyPlayer 播放器",
    "longDescription": "在本机播放 .qyp 回忆影片，文件不会上传。",
    "fileAssociations": [
      {
        "ext": ["qyp"],
        "name": "qyPlayer 影片",
        "description": "qyPlayer 回忆影片",
        "mimeType": "application/x-qyp"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
