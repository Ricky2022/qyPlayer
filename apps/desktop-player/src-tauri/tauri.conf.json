{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qyPlayer",
  "version": "0.2.0",
  "identifier": "io.github.ricky2022.qyplayer",
  "build": {
    "frontendDist": "../../web/dist-player"
  },
  "app": {
    "windows": [
      {
        "title": "qyPlayer",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Ricky2022",
    "homepage": "https://github.com/Ricky2022/qyPlayer",
    "copyright": "Copyright © 2026 Ricky2022",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "青云播放器 qyPlayer",
    "longDescription": "在本机播放 .qyp 回忆影片，文件不会上传。",
    "resources": {
      "icons/qyp-file.ico": "qyp-file.ico"
    },
    "fileAssociations": [
      {
        "ext": ["qyp"],
        "name": "qyPlayer.Film",
        "description": "qyPlayer memory film",
        "mimeType": "application/x-qyp"
      }
    ],
    "windows": {
      "nsis": {
        "template": "../../desktop-common/nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "startMenuFolder": "qyPlayer"
      }
    }
  }
}
