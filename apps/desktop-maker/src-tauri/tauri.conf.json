{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qyPlayer 制作器",
  "version": "0.1.0",
  "identifier": "io.github.ricky2022.qymaker",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "qyPlayer 制作器",
        "url": "create.html",
        "width": 1100,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "qyPlayer 制作器",
    "longDescription": "在本机把照片和视频生成 .qyp 回忆影片，文件不会上传。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
