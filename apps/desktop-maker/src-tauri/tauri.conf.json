{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qyMaker",
  "version": "0.2.0",
  "identifier": "io.github.ricky2022.qymaker",
  "build": {
    "frontendDist": "../../web/dist-maker"
  },
  "app": {
    "windows": [
      {
        "title": "qyMaker",
        "url": "create.html",
        "width": 1100,
        "height": 800,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Ricky2022",
    "homepage": "https://github.com/Ricky2022/qyPlayer",
    "copyright": "Copyright © 2026 Ricky2022",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "青云制作器 qyMaker",
    "longDescription": "在本机把照片和视频生成 .qyp 回忆影片，文件不会上传。",
    "windows": {
      "nsis": {
        "template": "../../desktop-common/nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "startMenuFolder": "qyMaker"
      }
    }
  }
}
